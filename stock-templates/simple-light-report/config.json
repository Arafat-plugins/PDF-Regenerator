{
    "name": "Simple Light Report",
    "description": "Clean white business report with a details table, line items and a summary",
    "page_size": "A4",
    "orientation": "portrait",
    "margins": {
        "top": 18,
        "right": 18,
        "bottom": 22,
        "left": 18,
        "footer": 9
    },
    "default_palette": "blue",
    "fields": [
        "title",
        "subtitle",
        "date",
        "client_name",
        "email",
        "phone",
        "website_url",
        "address",
        "amount",
        "status",
        "description",
        "summary_text",
        "detail_rows",
        "custom_fields",
        "line_items",
        "total",
        "footer_left",
        "footer_right"
    ],
    "defaults": {
        "footer_right": "Prepared with PDF Regenerator"
    },
    "palettes": {
        "blue": {
            "label": "Blue",
            "primary": "#2563eb",
